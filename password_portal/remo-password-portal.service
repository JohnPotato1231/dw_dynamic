[Unit]
Description=REMO online password verification portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/remo-password-portal
ExecStart=/usr/bin/python3 /opt/remo-password-portal/server.py --database /var/lib/remo-password-portal/state.sqlite3 --certificate /var/lib/remo-password-portal/server.crt --private-key /var/lib/remo-password-portal/server.key
Restart=on-failure
RestartSec=3
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/remo-password-portal
MemoryMax=256M
TasksMax=40

[Install]
WantedBy=multi-user.target
